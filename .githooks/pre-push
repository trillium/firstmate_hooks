#!/bin/sh
# Gate pushes on the tests and the type check, both run through bun.
set -e
cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR and friends to hooks. Left in place, the tests' scratch-repo git
# commands would run against this repository instead and commit, reset and reconfigure it.
for name in $(env | sed -n 's/^\(GIT_[A-Za-z_]*\)=.*/\1/p'); do unset "$name"; done
BUN="${BUN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}"
echo "pre-push: bun test" >&2
"$BUN" test
if [ -f tsconfig.json ]; then
  echo "pre-push: bun tsc --noEmit" >&2
  "$BUN" tsc --noEmit
fi
